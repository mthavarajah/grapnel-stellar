FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
WORKDIR /app
# Copy explicit paths only. Local .env files, .git and unrelated user files never enter the image.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile --filter @grapnel/api... --ignore-scripts
COPY packages/contracts/src packages/contracts/src
COPY packages/contracts/tsconfig.json packages/contracts/tsconfig.json
COPY apps/api/src apps/api/src
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY openapi openapi
COPY evidence/testnet.json evidence/testnet.json
COPY evidence/robinhood-own-roundtrip.json evidence/robinhood-amd-roundtrip.json evidence/robinhood-amzn-roundtrip.json evidence/robinhood-nflx-roundtrip.json evidence/robinhood-pltr-roundtrip.json evidence/
COPY evidence/zenex-roundtrip.json evidence/zenex-roundtrip.json
ENV NODE_ENV=production PORT=3001
USER node
EXPOSE 3001
CMD ["pnpm","--filter","@grapnel/api","start"]
