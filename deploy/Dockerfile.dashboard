FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
RUN pnpm install --frozen-lockfile --filter @grapnel/dashboard... --ignore-scripts
COPY packages/contracts packages/contracts
COPY apps/dashboard apps/dashboard
ARG NEXT_PUBLIC_VELOCITY_DEMO_URL
ENV NEXT_PUBLIC_VELOCITY_DEMO_URL=$NEXT_PUBLIC_VELOCITY_DEMO_URL
RUN pnpm --filter @grapnel/dashboard build
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
RUN chown -R node:node /app/apps/dashboard/.next
USER node
EXPOSE 3000
CMD ["sh", "-c", "exec pnpm --filter @grapnel/dashboard exec next start --hostname 0.0.0.0 --port \"$PORT\""]
